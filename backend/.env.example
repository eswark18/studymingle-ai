APP_ENV=development
DATABASE_URL=postgresql+asyncpg://studymingle:studymingle@localhost:5432/studymingle
FRONTEND_ORIGINS=http://localhost:5173,https://study.thoughtmingle.com
SESSION_COOKIE_NAME=studymingle_session
SESSION_TTL_HOURS=168
TURNSTILE_SECRET_KEY=
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_PUBLIC_ENDPOINT_URL=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_ACCESS_KEY_ID=studymingle
STORAGE_SECRET_ACCESS_KEY=studymingle-local-secret
STORAGE_BUCKET=studymingle-worksheets
STORAGE_AUTO_CREATE_BUCKET=true
UPLOAD_MAX_BYTES=10485760
OCR_MAX_PAGES=20
TUTOR_PROVIDER=ollama
TUTOR_MODEL=qwen3:4b
TUTOR_BASE_URL=http://localhost:11434
TUTOR_TIMEOUT_SECONDS=30
TUTOR_RATE_LIMIT_REQUESTS=12
TUTOR_RATE_LIMIT_WINDOW_SECONDS=60
TUTOR_MAX_HINTS=3

# Cloudflare Pages build variables
VITE_DEPLOYMENT_MODE=production
VITE_API_BASE_URL=https://api.study.thoughtmingle.com
VITE_TURNSTILE_SITE_KEY=replace-with-your-turnstile-site-key

# Cloudflare Pages Function secrets/variables
# Add these in Workers & Pages > StudyMingle > Settings > Variables and Secrets.
TURNSTILE_SECRET_KEY=replace-with-your-turnstile-secret
RESEND_API_KEY=replace-with-your-resend-api-key
DEMO_REQUEST_TO_EMAIL=hello@thoughtmingle.com
DEMO_REQUEST_FROM_EMAIL=StudyMingle <demo@thoughtmingle.com>
